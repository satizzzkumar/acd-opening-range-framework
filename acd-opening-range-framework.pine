//@version=5
//=============================================================================
// ACD Opening Range Framework
// TradingView Pine Script indicator for intraday opening-range analysis.
//
// This script defines a user-selected single-candle opening range, calculates
// stretch-based A/C levels, projects directional targets, and estimates
// position size based on risk per trade.
//
// Methodology inspiration:
// - Mark Fisher's ACD framework
// - Toby Crabel's opening-range concepts
//
// Features:
// - Single-candle Opening Range (configurable)
// - Daily Stretch calculation using historical lookback
// - A-up / A-down breakout reference levels
// - Directional targets and stop-loss reference levels
// - Risk-based position sizing and on-chart label output
//
// Notes:
// - Designed for educational and analytical use
// - Not financial advice or a guaranteed trading system
//=============================================================================

indicator("ACD Opening Range Framework", overlay=true, max_labels_count=500)

//================= INPUTS (SETTINGS) =================
or_candle_num = input.int(1, "OR Candle Number (e.g., enter 1 for the 1st candle)", minval = 1)
stretch_len   = input.int(10, "Stretch Lookback (days)", minval = 1)
capital_input = input.float(200000, "Capital")
risk_input    = input.float(2.0, "Risk Per Trade (%)", minval = 0.1, step = 0.1)

//================= DAILY STRETCH10 (NON-REPAINTING FIX) =================
// Stretch Calculation
stretch_calc = ta.sma(math.min(high - open, open - low), stretch_len)

[d_stretch_sma] = request.security(
     syminfo.tickerid,
     "D",
     [stretch_calc[1]], 
     lookahead = barmerge.lookahead_on)

var float day_stretch = na
new_day = ta.change(time("D")) != 0

if new_day
    day_stretch := d_stretch_sma

//================= OR VARIABLES =================
var float or_h = na
var float or_l = na
var int   bars = 0
var bool  ready = false

//================= NEW DAY RESET =================
if new_day
    or_h := na
    or_l := na
    bars := 0
    ready := false

//================= OPENING RANGE SELECTION (YOUR ORIGINAL LOGIC) =================
// Counting intraday candles
if not na(time)
    bars += 1

if new_day
    bars := 1

// Define the Opening Range (OR) using only the High/Low of a user-selected single candle from settings
if bars == or_candle_num
    or_h := high
    or_l := low
    ready := true

//================= A / C LEVELS =================
au_l = or_h + day_stretch
ad_l = or_l - day_stretch

//================= TARGETS / STOPS =================
buy_sl      = or_h 
first_buy_target  = au_l + (((au_l - or_h)*1.69) * 1)
second_buy_target =  au_l + ((au_l - or_h) * 3)

sell_sl     = or_l 
first_sell_target =  ad_l - (((or_l - ad_l)*1.69) * 1) 
second_sell_target = ad_l - ((or_l - ad_l) * 3)

//================= PLOTTING LEVELS =================
plot(ready ? or_h : na, "OR H", color.blue, 2, plot.style_circles)
plot(ready ? or_l : na, "OR L", color.blue, 2, plot.style_circles)
plot(ready ? au_l : na, "A U", color.green, 1, plot.style_circles)
plot(ready ? ad_l : na, "A D", color.green, 1, plot.style_circles)
plot(ready ? first_buy_target : na, "C U", color.orange, 1, plot.style_circles)
plot(ready ? first_sell_target : na, "C D", color.orange, 1, plot.style_circles)
plot(ready ? buy_sl : na, "Buy SL", color.new(color.red, 30), 1, plot.style_cross)
plot(ready ? second_buy_target : na, "Buy Target", color.red, 2, plot.style_circles)
plot(ready ? sell_sl : na, "Sell SL", color.new(color.red, 30), 1, plot.style_cross)
plot(ready ? second_sell_target : na, "Sell Target", color.red, 2, plot.style_circles)

//================= POSITION SIZING & LABEL =================
// Guard condition to avoid division-by-zero errors
risk_per_share_buy = au_l - buy_sl
risk_per_share_buy := risk_per_share_buy == 0 ? 0.01 : risk_per_share_buy

// User-defined capital risk per trade
risk_amount = capital_input * (risk_input / 100)

quantity = risk_amount / risk_per_share_buy
risk_percentage = (risk_per_share_buy / buy_sl) * 100

// Render the label only upon completion of the daily OR candle
if bars == or_candle_num
    label_text = "Stretch: " + str.tostring(math.round(day_stretch, 2)) + "\nQty: " + str.tostring(math.round(quantity, 0)) + " | Risk%: " + str.tostring(math.round(risk_percentage, 2)) + "%"
    label.new(bar_index, high * 1.004, label_text, color=color.new(color.blue, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
